{
  "name": "dsh-autorouter",
  "version": "0.3.0",
  "description": "AutoRouter — one DSH provider in front of a fallback chain over every registered route, with reasoning effort inherited from the caller.",
  "type": "module",
  "license": "MIT",
  "author": "Ruixin Zhan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZhanRuiXin/dsh-autorouter.git"
  },
  "homepage": "https://github.com/ZhanRuiXin/dsh-autorouter#readme",
  "bugs": {
    "url": "https://github.com/ZhanRuiXin/dsh-autorouter/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "llm",
    "router",
    "fallback",
    "provider",
    "reasoning-effort",
    "settings-ui"
  ],
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./bundle/cordis.patch.yml": "./bundle/cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "bundle",
    "locale",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./bundle/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "engines": {
    "node": ">=22"
  }
}
